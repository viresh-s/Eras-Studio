# Supabase Connection (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Recommended for admin moderation, reports, and COR subscriptions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site URL for callbacks & email redirects (e.g., https://eras-studio.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin & Session Credentials
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=admin2005
SESSION_SECRET=eras_studio_super_secret_jwt_key_2026_secure_random_seed_987654321
